{
  "name": "Simply Modern - Grid Reliability",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F1F2F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#DFDFE9"
              }
            }
          }
        ]
      }
    },
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#DFDFE9"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#323447"
              }
            },
            "checkboxAndApplyColor": {
              "solid": {
                "color": "#15CAB6"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#FCFDFE"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#323447"
              }
            },
            "transparency": 0
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#F1F2F7"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#323447"
              }
            },
            "transparency": 0
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#E4E7EF"
              }
            },
            "show": true,
            "radius": 12
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#F8FAF7"
              }
            },
            "foreground": {
              "solid": {
                "color": "#323447"
              }
            },
            "border": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ],
        "visualTooltip": [
          {
            "titleFontColor": {
              "solid": {
                "color": "#DFDFE9"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#F1F2F7"
              }
            },
            "background": {
              "solid": {
                "color": "#323447"
              }
            }
          }
        ],
        "visualHeaderTooltip": [
          {
            "titleFontColor": {
              "solid": {
                "color": "#DFDFE9"
              }
            },
            "background": {
              "solid": {
                "color": "#323447"
              }
            }
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#323447"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#5F6B6D"
              }
            }
          }
        ],
        "items": [
          {
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#323447"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4E7EF"
              }
            },
            "radius": 12,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#323447"
              }
            },
            "transparency": 92,
            "position": "Outer",
            "preset": "BottomRight"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4E7EF"
              }
            },
            "radius": 12,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#323447"
              }
            },
            "transparency": 92,
            "position": "Outer",
            "preset": "BottomRight"
          }
        ]
      }
    }
